# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/polymarket_copytrade

PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
# PRIVY_VERIFICATION_KEY=-----BEGIN PUBLIC KEY-----...
PRIVY_KEY_QUORUM_ID=your_privy_key_quorum_id
PRIVY_AUTHORIZATION_PRIVATE_KEY=wallet-auth:your_authorization_private_key

# Copytrade Worker polling interval (ms, default 15000)
# COPYTRADE_POLL_MS=15000

# Polygon RPC (wallet_status / wallet_approve / place_order required)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Trading wallet private key (for approve, split, place_order)
